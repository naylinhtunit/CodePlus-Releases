{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodePlus",
  "version": "0.1.28",
    "identifier": "com.codeplus.desktop",
  "build": {
    "frontendDist": "../.desktop-dist",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run desktop:prepare"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "CodePlus", "width": 1440, "height": 920, "minWidth": 1080, "minHeight": 700 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": { "signingIdentity": "-" },
    "icon": ["icons/codeplus.icns", "icons/codeplus.ico", "icons/codeplus.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGREUyQjcyRTMxNzJBREMKUldUY0toZmpjaXZlcjAwUld4Y3Z6elpyTHNJQmlPNUxwQ2NaalZ4Nnl5S2xaMFpJTFVBZ2lBRFQK",
      "endpoints": [
        "https://github.com/naylinhtunit/CodePlus-Releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
